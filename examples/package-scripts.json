{
  "audit:performance": "bun --filter @your-org/hyperdrive-auditor audit -- --root . --profile balanced",
  "audit:performance:ci": "bun --filter @your-org/hyperdrive-auditor audit -- --root . --profile ci --fail-on high",
  "audit:performance:md": "bun --filter @your-org/hyperdrive-auditor audit -- --root . --profile ci --format markdown --output hyperdrive-report.md",
  "audit:performance:graph": "bun --filter @your-org/hyperdrive-auditor audit -- --root . --profile ci --graph-output hyperdrive-graph.json --type-report-output hyperdrive-type-report.json --fix-suggestions-output hyperdrive-fixes.json",
  "audit:performance:sarif": "bun --filter @your-org/hyperdrive-auditor audit -- --root . --profile ci --sarif-output hyperdrive.sarif",
  "audit:performance:budgets": "bun --filter @your-org/hyperdrive-auditor audit -- --root . --profile ci --budget-output hyperdrive-budget.json --budget-fail",
  "audit:performance:fixes": "bun --filter @your-org/hyperdrive-auditor audit -- --root . --fix-dry-run --fix-report-output hyperdrive-fix-report.json"
}
